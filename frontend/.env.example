# URL del backend FastAPI (sin barra final). Nunca pongas claves de IA aquí.
# En Vercel: la URL pública de Render, p. ej. https://tu-servicio.onrender.com
VITE_URL_BASE_API=http://localhost:8000

# ID de cliente OAuth de Google (tipo "Aplicación web"). Es PÚBLICO (termina en el bundle):
# nunca pongas aquí un "client secret". Formato: 1234567890-abc123.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=
