# Copia este archivo como `.env` y completa los valores. NUNCA subas `.env` a git.
# --- OpenAI (obligatorias para generar resúmenes) ---
OPENAI_API_KEY=
# Nombre exacto del modelo que quieres usar (el código no tiene ninguno por defecto).
OPENAI_MODEL=

# --- OpenAI (opcionales) ---
# Segundos máximos de espera por llamada y reintentos automáticos ante fallos transitorios.
OPENAI_TIMEOUT_SEGUNDOS=45
OPENAI_MAX_REINTENTOS=1
# Espera máxima al analizar un PDF completo (texto y elementos visuales); suele tardar más que un texto.
OPENAI_TIMEOUT_PDF_SEGUNDOS=180

# --- Pruebas (módulo con IA) ---
# Clave que cifra el estado de cada prueba (el backend no guarda nada). Pon una cadena larga y aleatoria,
# p. ej. `python -c "import secrets; print(secrets.token_urlsafe(48))"`. Si falta, se usa una clave temporal y
# las pruebas en curso se pierden cuando el servidor se reinicia. En Render defínela como variable de entorno.
PRUEBAS_CLAVE_SECRETA=
# Espera máxima al generar las preguntas de una prueba (hasta 25 por prueba).
OPENAI_TIMEOUT_PRUEBAS_SEGUNDOS=120

# --- Límites del contenido (opcionales; el frontend usa los mismos valores en src/configuracion.ts) ---
RESUMEN_MIN_CARACTERES=100
RESUMEN_MAX_CARACTERES=20000
PDF_MAX_BYTES=10485760
PDF_MAX_PAGINAS=100

# --- CORS: orígenes del frontend separados por comas ---
ORIGENES_PERMITIDOS=http://localhost:5173
